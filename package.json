{
  "name": "miniworld",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --config app/vite.config.ts",
    "build": "npm run build-data && vite build --config app/vite.config.ts && node data/build/check-size.ts",
    "preview": "vite preview --config app/vite.config.ts",
    "fetch-data": "node data/build/fetch-data.ts",
    "simplify-data": "node data/build/simplify-data.ts",
    "build-data": "node data/build/build-data.ts",
    "tree": "node data/build/tree.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "golden": "vitest run app/src/planet/golden.test.ts data/build/pipeline.test.ts app/src/world/onLand",
    "check": "npm run lint && npm run typecheck && npm run test",
    "test:browser": "playwright test",
    "staging": "node scripts/staging.ts",
    "fixture-key": "node data/build/fixture-key.ts",
    "notices": "node data/build/notices.ts",
    "perf": "playwright test --project=perf",
    "asset-sheets": "node assets/sheets.ts",
    "anim": "node assets/anim.ts",
    "approve-assets": "node assets/approve.ts",
    "loading-shot": "node scripts/loading-shot.ts"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "preact": "11.0.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "geotiff": "3.0.5",
    "h5wasm": "0.10.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
