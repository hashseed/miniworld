{
  "name": "miniworld",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --config app/vite.config.ts",
    "build": "npm run build-data && vite build --config app/vite.config.ts && node data/build/check-size.ts",
    "preview": "vite preview --config app/vite.config.ts",
    "fetch-data": "node data/build/fetch-data.ts",
    "build-data": "node data/build/build-data.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "test:browser": "playwright test",
    "perf": "playwright test --project=perf"
  },
  "dependencies": {
    "preact": "11.0.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "eslint": "10.13.0",
    "geotiff": "3.0.5",
    "netcdfjs": "4.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
